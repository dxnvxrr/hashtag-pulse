# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Number of trusted reverse-proxy hops in front of the API (1 behind a typical load balancer).
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://omt:omt_dev_password@localhost:5432/onemoretap?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-to-48-random-bytes-base64-change-me-change-me
JWT_ISSUER=https://api.onemoretap.game
JWT_AUDIENCE=onemoretap-client
# Server-side pepper mixed into device fingerprints before they are stored or embedded in tokens.
DEVICE_FINGERPRINT_PEPPER=change-me-to-32-random-bytes-base64

# Comma-separated browser origins allowed by CORS (native clients send no Origin header).
CORS_ORIGINS=https://onemoretap.game,https://admin.onemoretap.game

# Sign in with Apple — the app's bundle id (audience of Apple identity tokens).
APPLE_BUNDLE_ID=com.example.onemoretap

# Google Play Games Services — OAuth web client used to exchange server auth codes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# App Store Server API (In-App Purchase key from App Store Connect).
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
# PEM contents with literal \n for newlines.
APPSTORE_PRIVATE_KEY=
APPSTORE_ENVIRONMENT=sandbox

# Google Play Developer API service account.
GOOGLE_PLAY_PACKAGE_NAME=com.example.onemoretap
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
# PEM contents with literal \n for newlines.
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=

# LevelPlay (ironSource) server-to-server rewarded callback private key.
LEVELPLAY_SSV_PRIVATE_KEY=

# Web client directory served at /play (relative to the working directory). Empty to disable.
WEB_ROOT=../Web
# Run background jobs (run expiry, 30-day account purge, telemetry drain) in this process.
RUN_JOBS=true
# Web ads (Google H5 Games Ads) have no server callback; true lets the web client attest a rewarded view (caps still apply).
WEB_ADS_CLIENT_ATTESTED=false
# Google AdSense publisher id (ca-pub-...) for H5 Games Ads on the web client. Empty = house popup (earns nothing).
WEB_AD_CLIENT=

# Monthly skill-prize seasons (see ONE_MORE_TAP.md). Keep false until a lawyer has approved the official rules.
PRIZES_ENABLED=false
# Countries (ISO 3166-1 alpha-2, comma-separated) where prizes may be paid. Empty = nowhere.
PRIZE_COUNTRIES=
# Identity-verification provider's hosted flow (the winner's card links here with ?reference=<payout id>).
PRIZE_VERIFY_URL=
# Public official-rules page.
PRIZE_RULES_URL=

# Shown on /privacy (required in production): who publishes the game and where privacy requests go.
PUBLISHER_NAME=
CONTACT_EMAIL=
# Challenge links open the installed app. iOS: your Apple Team ID + APPLE_BUNDLE_ID. Android: GOOGLE_PLAY_PACKAGE_NAME
# + the SHA-256 of the Play app-signing certificate (Play Console → App signing).
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
# The app (Capacitor) calls the API from these origins; add them to CORS_ORIGINS:
#   capacitor://localhost (iOS), https://localhost (Android)
