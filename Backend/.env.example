# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Number of trusted reverse-proxy hops in front of the API (1 behind a typical load balancer).
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://omt:omt_dev_password@localhost:5432/onemoretap?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-to-48-random-bytes-base64-change-me-change-me
JWT_ISSUER=https://api.onemoretap.game
JWT_AUDIENCE=onemoretap-client
# Server-side pepper mixed into device fingerprints before they are stored or embedded in tokens.
DEVICE_FINGERPRINT_PEPPER=change-me-to-32-random-bytes-base64

# Comma-separated browser origins allowed by CORS (native clients send no Origin header).
CORS_ORIGINS=https://onemoretap.game,https://admin.onemoretap.game

# Sign in with Apple — the app's bundle id (audience of Apple identity tokens).
APPLE_BUNDLE_ID=com.example.onemoretap

# Google Play Games Services — OAuth web client used to exchange server auth codes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# App Store Server API (In-App Purchase key from App Store Connect).
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
# PEM contents with literal \n for newlines.
APPSTORE_PRIVATE_KEY=
APPSTORE_ENVIRONMENT=sandbox

# Google Play Developer API service account.
GOOGLE_PLAY_PACKAGE_NAME=com.example.onemoretap
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
# PEM contents with literal \n for newlines.
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=

# LevelPlay (ironSource) server-to-server rewarded callback private key.
LEVELPLAY_SSV_PRIVATE_KEY=
