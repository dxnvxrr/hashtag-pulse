// One More Tap — production PostgreSQL schema.
// Balance non-negativity is enforced by CHECK constraints in the initial migration
// (Prisma cannot express CHECK constraints in the schema language).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  QUARANTINED
  BANNED
  PENDING_DELETION
}

enum Platform {
  IOS
  ANDROID
  EDITOR
  WEB
}

enum IdentityProvider {
  APPLE
  GOOGLE_PLAY_GAMES
}

enum Currency {
  TICKS
  CORES
  SLOWMO_TICKETS
  ANCHORS
}

enum TransactionReason {
  RUN_REWARD
  IAP_PURCHASE
  AD_REWARD
  ITEM_PURCHASE
  ACCOUNT_MERGE
  ADMIN_ADJUSTMENT
  REFUND_REVERSAL
}

enum Store {
  APP_STORE
  GOOGLE_PLAY
}

enum PurchaseStatus {
  VERIFIED
  REJECTED
  REFUNDED
}

enum Region {
  NA
  SA
  EU
  AF
  ME
  AS
  OC
}

enum RunMode {
  RANKED
  PULSE
  GAUNTLET
  DUEL
  ZEN
}

enum RunStatus {
  ACTIVE
  VALIDATED
  QUARANTINED
  REJECTED
  EXPIRED
}

enum AdRewardStatus {
  PENDING
  GRANTED
  EXPIRED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  status          UserStatus @default(ACTIVE)
  /// ELO-like precision rating, 0–3000.
  precisionRating Int        @default(1000)
  /// Best single-tap delta in microseconds (lower is better).
  bestDeltaUs     Int?
  /// Prestige level 0–100: golden circles filled in Ranked. Each level unlocks a background.
  prestige        Int        @default(0)
  /// COPPA: under-13 accounts get no personalised ads, no social, minimal telemetry.
  isMinor         Boolean    @default(false)
  /// Set once the player answers the age gate; afterwards isMinor can only become stricter.
  ageGateAnsweredAt DateTime?
  /// Self-declared 18+ at the age gate (never set for minors). Prize payouts still verify age with ID.
  isAdult         Boolean    @default(false)
  /// Generated leaderboard name ("Swift Comet 4821"); players reroll it, never type it.
  displayName     String?
  /// Leaderboard region, self-selected (defaulted from the device time zone). Null = global boards only.
  region          Region?
  regionChangedAt DateTime?
  /// IANA time zone the daily streak counts days in.
  timeZone        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletionRequestedAt DateTime?

  wallet        Wallet?
  devices       Device[]
  identities    Identity[]
  refreshTokens RefreshToken[]
  transactions  Transaction[]
  purchases     Purchase[]
  runs          Run[]
  adRewards     AdReward[]
  auditLogs     AuditLog[]
  stats         PlayerStats?
  airdropEntries AirdropEntry[]
  prizePayouts  PrizePayout[]

  @@map("users")
}

model Device {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  /// HMAC-SHA256(pepper, client fingerprint). The raw fingerprint is never stored.
  fingerprintHash String   @unique @db.VarChar(64)
  platform        Platform
  model           String   @db.VarChar(128)
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("devices")
}

model Identity {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  provider  IdentityProvider
  /// Stable subject from the provider (Apple `sub`, Google Play Games player id).
  subject   String           @db.VarChar(255)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("identities")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  deviceId    String    @db.Uuid
  /// SHA-256 of the opaque refresh token. Plaintext is only ever held by the client.
  tokenHash   String    @unique @db.VarChar(64)
  /// Rotation family: reuse of a rotated token revokes the whole family.
  familyId    String    @db.Uuid
  expiresAt   DateTime
  revokedAt   DateTime?
  rotatedAt   DateTime?
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Wallet {
  userId        String   @id @db.Uuid
  /// Soft currency.
  ticks         BigInt   @default(0)
  /// Hard currency.
  cores         BigInt   @default(0)
  slowMoTickets Int      @default(3)
  anchors       Int      @default(0)
  /// Optimistic-concurrency counter, incremented on every mutation.
  version       Int      @default(0)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

/// Append-only ledger. Every wallet mutation writes exactly one row per currency touched.
model Transaction {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  currency       Currency
  /// Signed delta (credit > 0, debit < 0).
  amount         BigInt
  balanceAfter   BigInt
  reason         TransactionReason
  /// Unique per logical operation, e.g. "run:<runId>:TICKS" — makes grants idempotent.
  idempotencyKey String            @unique @db.VarChar(200)
  metadata       Json?
  createdAt      DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("transactions")
}

model Purchase {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @db.Uuid
  store              Store
  productId          String         @db.VarChar(128)
  storeTransactionId String         @db.VarChar(255)
  status             PurchaseStatus
  environment        String         @db.VarChar(32)
  verifiedPayload    Json?
  createdAt          DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([store, storeTransactionId])
  @@index([userId])
  @@map("purchases")
}

model Run {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  mode         RunMode
  /// uint32 PRNG seed stored as bigint.
  seed         BigInt
  status       RunStatus @default(ACTIVE)
  baseDurationMs Int
  /// First-ever run: ring 0 gets the generous FTUE window.
  ftue         Boolean   @default(false)
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  ringsPlayed  Int       @default(0)
  perfects     Int       @default(0)
  cleans       Int       @default(0)
  closes       Int       @default(0)
  misses       Int       @default(0)
  totalDeltaUs BigInt    @default(0)
  bestDeltaUs  Int?
  ticksAwarded Int       @default(0)
  /// The verdicts that count toward lifetime stats: Ranked only, Slow-Mo rings excluded (tickets can be bought).
  statPerfects Int       @default(0)
  statCleans   Int       @default(0)
  statCloses   Int       @default(0)
  /// Challenge score: hits and average |delta| within the first 5 lives (what challenge links compare).
  scoreHits    Int?
  scoreAvgUs   Int?
  /// DUEL runs started from a challenge link: the challenger's run.
  challengeRunId String?  @db.Uuid
  flags        String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([status])
  @@index([mode, status, submittedAt])
  @@index([challengeRunId])
  @@map("runs")
}

model AdReward {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  placement      String         @db.VarChar(64)
  status         AdRewardStatus @default(PENDING)
  /// Ad network's event id from the S2S callback — dedupes network retries.
  networkEventId String?        @unique @db.VarChar(128)
  createdAt      DateTime       @default(now())
  expiresAt      DateTime
  grantedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ad_rewards")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @db.Uuid
  action    String   @db.VarChar(64)
  severity  String   @db.VarChar(16)
  ip        String?  @db.VarChar(64)
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Analytics sink fed by the telemetry consumer worker (Redis Streams -> here). Swap for a warehouse at scale.
model TelemetryEvent {
  id         BigInt   @id @default(autoincrement())
  /// Redis stream entry id — unique so redelivered entries are ignored.
  streamId   String   @db.VarChar(64)
  category   String   @db.VarChar(32)
  name       String   @db.VarChar(64)
  userId     String   @db.Uuid
  clientTs   DateTime
  receivedAt DateTime
  appVersion String   @db.VarChar(32)
  platform   String   @db.VarChar(16)
  sessionId  String   @db.VarChar(64)
  props      Json

  @@unique([category, streamId])
  @@index([category, name, receivedAt])
  @@map("telemetry_events")
}

/// Lifetime Ranked totals shown to the player, updated with each verified Ranked run. Display only: airdrop
/// snapshots recompute from the runs table, so a run quarantined later can't keep its credit.
model PlayerStats {
  userId     String   @id @db.Uuid
  perfects   Int      @default(0)
  cleans     Int      @default(0)
  closes     Int      @default(0)
  rankedRuns Int      @default(0)
  /// Daily streak (verified Ranked runs, counted in the player's time zone). Days are YYYY-MM-DD.
  dailyLast   String?
  dailyStreak Int      @default(0)
  dailyBest   Int      @default(0)
  anchors     Int      @default(0)
  dailyPlayed String[]
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_stats")
}

enum SnapshotStatus {
  DRAFT
  FINAL
  CANCELLED
}

/// A frozen record of every player's skill score at a cutoff, for a future token distribution. Built only by the
/// operator CLI (src/cli/airdrop.ts); there is no HTTP surface. Once FINAL it can't change (database trigger).
model AirdropSnapshot {
  id            String         @id @default(uuid()) @db.Uuid
  label         String         @unique
  /// Only runs submitted in [fromAt, cutoffAt) count; fromAt null = from the beginning.
  fromAt        DateTime?
  cutoffAt      DateTime
  status        SnapshotStatus @default(DRAFT)
  weightPerfect Int
  weightClean   Int
  weightClose   Int
  minRankedRuns Int
  eligibleUsers Int            @default(0)
  totalPoints   BigInt         @default(0)
  /// SHA-256 over the eligible entries (user id and points, sorted by user id), recorded when finalised.
  digest        String?
  createdAt     DateTime       @default(now())
  finalizedAt   DateTime?

  entries AirdropEntry[]
  season  PrizeSeason?

  @@map("airdrop_snapshots")
}

model AirdropEntry {
  snapshotId     String  @db.Uuid
  userId         String  @db.Uuid
  perfects       Int
  cleans         Int
  closes         Int
  rankedRuns     Int
  points         BigInt
  eligible       Boolean
  /// Why an ineligible player was left out: minor, not_adult, deletion_pending, account_status, anticheat_review,
  /// too_few_runs.
  excludedReason String?

  snapshot AirdropSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([snapshotId, userId])
  @@index([snapshotId, eligible])
  @@map("airdrop_entries")
}

enum PayoutStatus {
  /// Won; the player must verify identity, age (18+) and country before the deadline.
  AWAITING_VERIFICATION
  VERIFIED
  PAID
  /// Failed verification (under 18, excluded country, duplicate person) or broke the rules.
  FORFEITED
  /// Not verified before the deadline.
  EXPIRED
}

/// A monthly skill-prize season: a pool (a share of that month's ad revenue) split by season points.
/// Created only when the operator closes the month (src/cli/season.ts), from a finalised snapshot.
model PrizeSeason {
  id             String         @id @default(uuid()) @db.Uuid
  /// The season id, "2026-10".
  label          String         @unique
  snapshotId     String         @unique @db.Uuid
  poolCents      Int
  currency       String         @default("USD")
  /// Most one player can win, in basis points of the pool (500 = 5%).
  capBps         Int
  /// Shares smaller than this are not paid out (fees would eat them); that money goes to the other winners.
  minPayoutCents Int
  /// Pool money nobody received (everyone capped). Roll it into the next pool.
  unallocatedCents Int
  claimDeadline  DateTime
  createdAt      DateTime       @default(now())

  snapshot AirdropSnapshot @relation(fields: [snapshotId], references: [id])
  payouts  PrizePayout[]

  @@map("prize_seasons")
}

model PrizePayout {
  id           String       @id @default(uuid()) @db.Uuid
  seasonId     String       @db.Uuid
  userId       String       @db.Uuid
  rank         Int
  halfPoints   BigInt
  amountCents  Int
  status       PayoutStatus @default(AWAITING_VERIFICATION)
  /// Opaque reference from the identity-verification provider: one payout per real person per season.
  identityRef  String?
  /// ISO 3166-1 alpha-2, from verification.
  country      String?
  statusReason String?
  verifiedAt   DateTime?
  paidAt       DateTime?
  /// The payout provider's batch or transfer id.
  providerRef  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  season PrizeSeason @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@unique([seasonId, identityRef])
  @@index([status])
  @@map("prize_payouts")
}
