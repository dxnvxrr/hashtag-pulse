{
  "name": "one-more-tap-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One More Tap — authoritative game backend (Fastify + Prisma + Redis)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "test": "node --import tsx --test test/*.test.ts",
    "airdrop": "node dist/cli/airdrop.js",
    "season": "node dist/cli/season.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "6.19.3",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "6.19.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
